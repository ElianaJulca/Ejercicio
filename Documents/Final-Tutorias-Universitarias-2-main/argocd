# argocd/tutorias-app.yaml
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: tutorias-universitarias-stack
  namespace: argocd
spec:
  project: default
  source:
    repoURL: <TU_URL_DEL_REPOSITORIO_GIT> # ¡CRÍTICO: TU URL REAL!
    targetRevision: HEAD
    path: tutorias-stack # Apunta a tu Umbrella Chart
  destination:
    server: https://kubernetes.default.svc
    namespace: tutorias
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
    - ServerSideApply=true